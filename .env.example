# Every key is optional. A missing key switches that integration to recorded
# fixtures, and the console shows which ones are simulated.

# Postgres. Unset = local PGlite database in .data/pglite (zero setup).
DATABASE_URL=

# Google AI Studio key (free tier). Unset = template messages, no extraction.
GEMINI_API_KEY=
# Comma-separated fallbacks are tried in order. gemini-2.5-flash is closed to new keys.
GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite

# Global Forest Watch Data API key, and the origin registered with the key.
GFW_API_KEY=
GFW_ORIGIN=

# Telegram bot from @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# Inngest (free plan). Unset in dev = Inngest dev server.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# openrouteservice key (free) for road travel times. Unset = straight-line estimates, labelled as such.
# Weather comes from Open-Meteo, which needs no key.
ORS_API_KEY=

# Gmail intake (read-only scope). Create an OAuth client in Google Cloud, keep the
# consent screen in testing mode, and get a refresh token for the exporter's inbox.
# Unset = "Load sample inbox" on the Intake page uses recorded synthetic emails.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_QUERY=label:kaffa newer_than:30d

# Brevo (free transactional email) for approved replies to buyers. Unset = approved replies are
# recorded on the ledger and copied from the console instead of being sent.
BREVO_API_KEY=
BREVO_SENDER=

# Shared secret for the daily cron endpoint.
CRON_SECRET=

APP_URL=http://localhost:3000

# Production only: set to 1 to allow the synthetic field-agent picker without Telegram.
DEMO_MODE=
